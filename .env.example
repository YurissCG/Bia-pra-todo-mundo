# ─── Meta / Facebook ───────────────────────────────────────────────
# ID do Pixel (aparece na URL do Gerenciador de Eventos). Público.
NEXT_PUBLIC_META_PIXEL_ID=

# Token da Conversions API. SECRETO — só no servidor, nunca com prefixo NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# Código de teste do Gerenciador de Eventos. APENAS em desenvolvimento — deixe vazio em produção.
META_TEST_EVENT_CODE=

# Versão da Graph API usada na Conversions API. Opcional (padrão: v26.0).
META_GRAPH_API_VERSION=v26.0

# ─── WhatsApp ──────────────────────────────────────────────────────
# Link de convite do grupo. Público. O lead é redirecionado pra cá depois do envio.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# ─── Contato / LGPD ────────────────────────────────────────────────
# E-mail pra pedidos de exclusão de dados e identificação do anunciante.
# Sem isso, o rodapé e a /privacidade caem pro fallback "pelo grupo do WhatsApp".
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=

# Service role key. SECRETA — só no servidor, nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
