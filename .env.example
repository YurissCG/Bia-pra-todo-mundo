# ─── WhatsApp ──────────────────────────────────────────────────────
# Link de convite do grupo. Público. O botão de CTA leva direto pra cá.
NEXT_PUBLIC_WHATSAPP_GROUP_URL=

# ─── Meta / Facebook ───────────────────────────────────────────────
# Dataset ID (era "Pixel ID") — aparece no Gerenciador de Eventos. Público.
NEXT_PUBLIC_META_PIXEL_ID=

# Token da Conversions API (Gerenciador de Eventos > Conversions API >
# Gerar token de acesso). SECRETO — só no servidor, nunca com NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# Código de teste do Gerenciador de Eventos. APENAS em desenvolvimento — deixe vazio em produção.
META_TEST_EVENT_CODE=

# Versão da Graph API usada na Conversions API. Opcional (padrão: v26.0).
META_GRAPH_API_VERSION=v26.0

# ─── Contato / LGPD ────────────────────────────────────────────────
# E-mail de contato mostrado no rodapé e na /privacidade.
# Sem isso, cai pro fallback "pelo grupo do WhatsApp".
NEXT_PUBLIC_CONTACT_EMAIL=

# ─── Metadados (opcional) ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
